# Example environment file
# Copy this to .env and customize for your environment

# Forgejo Configuration
FORGEJO_DOMAIN=localhost
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=222

# Database Configuration
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=changeme-secure-password
POSTGRES_DB=forgejo

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-secure-password
MINIO_BUCKET=forgejo-lfs

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-secure-password

# Security
# Generate with: openssl rand -base64 32
SECRET_KEY=changeme-generate-with-openssl
LFS_JWT_SECRET=changeme-generate-with-openssl

# Backup Configuration
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=7

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16

# Resource Limits
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
MINIO_MEMORY_LIMIT=512M
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90

# Features
ENABLE_SSH_CERT_AUTH=true
ENABLE_GPG_SIGNING=true
ENABLE_LFS=true
ENABLE_ACTIONS=true
ENABLE_AUDIT_LOG=true

# External URLs (for production)
# FORGEJO_ROOT_URL=https://git.yourdomain.com
# MINIO_ENDPOINT=https://s3.yourdomain.com
# KEYCLOAK_URL=https://auth.yourdomain.com
