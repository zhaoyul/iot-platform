<?xml version="1.0" encoding="UTF-8"?>
<!-- Example Rockwell Automation L5X file for testing renderer -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.02" 
                     TargetName="MainController" TargetType="Controller" 
                     ContainsContext="true" ExportDate="Wed Dec 18 12:00:00 2024" 
                     ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
    
    <Controller Use="Context" Name="MainController" ProcessorType="1756-L85E" 
                MajorRev="32" MinorRev="11" TimeSlice="20" 
                ShareUnusedTimeSlice="1" ProjectCreationDate="Tue Jan 01 00:00:00 2024" 
                LastModifiedDate="Wed Dec 18 12:00:00 2024" 
                SFCExecutionControl="CurrentActive" SFCRestartPosition="MostRecent" 
                SFCLastScan="DontScan" CommPath="AB_ETHIP-1\192.168.1.10\Backplane\0">
        
        <RedundancyInfo Enabled="false" KeepTestEditsOnSwitchOver="false" 
                        IOMemoryPadPercentage="90" DataTablePadPercentage="50"/>
        
        <Security Code="0" ChangesToDetect="16#ffff_ffff_ffff_ffff"/>
        
        <SafetyInfo/>
        
        <!-- Controller Tags -->
        <Tags>
            <Tag Name="Emergency_Stop" TagType="Base" DataType="BOOL" Radix="Decimal" 
                 Constant="false" ExternalAccess="Read/Write">
                <Description>
                    <![CDATA[Emergency stop button input from safety circuit]]>
                </Description>
                <Data Format="Decorated">
                    <DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
                </Data>
            </Tag>
            
            <Tag Name="Motor_Speed_SP" TagType="Base" DataType="REAL" Radix="Float" 
                 Constant="false" ExternalAccess="Read/Write">
                <Description>
                    <![CDATA[Motor speed setpoint in RPM]]>
                </Description>
                <Data Format="Decorated">
                    <DataValue DataType="REAL" Radix="Float" Value="1500.0"/>
                </Data>
            </Tag>
            
            <Tag Name="Motor_Running" TagType="Base" DataType="BOOL" Radix="Decimal" 
                 Constant="false" ExternalAccess="Read/Write">
                <Description>
                    <![CDATA[Motor running status indicator]]>
                </Description>
                <Data Format="Decorated">
                    <DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
                </Data>
            </Tag>
            
            <Tag Name="Production_Counter" TagType="Base" DataType="DINT" Radix="Decimal" 
                 Constant="false" ExternalAccess="Read/Write">
                <Description>
                    <![CDATA[Total production count]]>
                </Description>
                <Data Format="Decorated">
                    <DataValue DataType="DINT" Radix="Decimal" Value="0"/>
                </Data>
            </Tag>
        </Tags>
        
        <!-- Programs -->
        <Programs>
            <Program Name="MainProgram" Type="Normal" TestEdits="false" 
                     MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
                
                <Tags>
                    <Tag Name="Cycle_Timer" TagType="Base" DataType="TIMER" 
                         Constant="false" ExternalAccess="Read/Write">
                        <Description>
                            <![CDATA[Production cycle timer]]>
                        </Description>
                    </Tag>
                </Tags>
                
                <Routines>
                    <Routine Name="MainRoutine" Type="RLL">
                        <Description>
                            <![CDATA[Main control routine for production line]]>
                        </Description>
                        
                        <RLLContent>
                            <!-- Rung 0: Emergency Stop Logic -->
                            <Rung Number="0" Type="N">
                                <Comment>
                                    <![CDATA[Emergency stop monitoring - latches until manually reset]]>
                                </Comment>
                                <Text>
                                    <![CDATA[XIC(Emergency_Stop)OTL(Motor_Running);]]>
                                </Text>
                            </Rung>
                            
                            <!-- Rung 1: Motor Start Logic -->
                            <Rung Number="1" Type="N">
                                <Comment>
                                    <![CDATA[Start motor when start button pressed and no emergency stop]]>
                                </Comment>
                                <Text>
                                    <![CDATA[XIC(Start_Button)XIO(Emergency_Stop)OTE(Motor_Running);]]>
                                </Text>
                            </Rung>
                            
                            <!-- Rung 2: Production Counter -->
                            <Rung Number="2" Type="N">
                                <Comment>
                                    <![CDATA[Increment production counter on part detection]]>
                                </Comment>
                                <Text>
                                    <![CDATA[XIC(Part_Detected)ONS(Counter_Trigger)ADD(Production_Counter,1,Production_Counter);]]>
                                </Text>
                            </Rung>
                            
                            <!-- Rung 3: Cycle Timer -->
                            <Rung Number="3" Type="N">
                                <Comment>
                                    <![CDATA[Cycle timer for production tracking]]>
                                </Comment>
                                <Text>
                                    <![CDATA[XIC(Motor_Running)TON(Cycle_Timer,?,?);]]>
                                </Text>
                            </Rung>
                            
                            <!-- Rung 4: Speed Control -->
                            <Rung Number="4" Type="N">
                                <Comment>
                                    <![CDATA[Send speed setpoint to VFD via analog output]]>
                                </Comment>
                                <Text>
                                    <![CDATA[XIC(Motor_Running)MOV(Motor_Speed_SP,VFD_Speed_Command);]]>
                                </Text>
                            </Rung>
                        </RLLContent>
                    </Routine>
                    
                    <Routine Name="SafetyRoutine" Type="RLL">
                        <Description>
                            <![CDATA[Safety interlocks and monitoring]]>
                        </Description>
                        
                        <RLLContent>
                            <Rung Number="0" Type="N">
                                <Comment>
                                    <![CDATA[Safety gate monitoring]]>
                                </Comment>
                                <Text>
                                    <![CDATA[XIO(Safety_Gate_Open)XIO(Light_Curtain_Broken)OTE(Safety_OK);]]>
                                </Text>
                            </Rung>
                        </RLLContent>
                    </Routine>
                </Routines>
            </Program>
        </Programs>
        
        <Tasks>
            <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" 
                  DisableUpdateOutputs="false" InhibitTask="false">
                <ScheduledPrograms>
                    <ScheduledProgram Name="MainProgram"/>
                </ScheduledPrograms>
            </Task>
        </Tasks>
    </Controller>
</RSLogix5000Content>
