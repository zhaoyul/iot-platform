data/
*.log

# Temporary files
tmp/
*.tmp
*.swp
*~

# IDE and editor files
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# Environment files with secrets
.env
*.secret
*.key

# Build artifacts
dist/
build/
*.pyc
__pycache__/
node_modules/

# Backup files
*.bak
*.backup
